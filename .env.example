# Copy to .env.local and fill in. Never commit .env.local.

# Site
NEXT_PUBLIC_SITE_NAME=Arbek
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # set to https://www.arbek.co or https://www.arbek.us at go-live
NEXT_PUBLIC_CURRENCY=USD

# Payments (Stripe)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Database
DATABASE_URL=

# Auth
AUTH_SECRET=

# Email (transactional)
EMAIL_FROM=orders@arbek.co
RESEND_API_KEY=
